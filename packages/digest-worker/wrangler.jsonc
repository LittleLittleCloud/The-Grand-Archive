{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dak-digest-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["0 8 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dak",
      "database_id": "3613c8de-a4cb-472c-b00f-b4a4cc2bb5a0"
    }
  ],
  "workflows": [
    {
      "name": "dak-digest-workflow",
      "binding": "DIGEST_WORKFLOW",
      "class_name": "DigestWorkflow"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "PUBLIC_BASE_URL": "https://dak-news.com",
    "EMAIL_FROM": "dispatch@dak-news.com",
    "DIGEST_MODEL": "workers-ai/@cf/moonshotai/kimi-k2.6",
    // AI Gateway config (non-secret). CI sets these on every deploy. Only
    // CLOUDFLARE_API_KEY is a real secret (set via `wrangler secret put`).
    // ⚠️ CLOUDFLARE_GATEWAY_ID must match the name of your AI Gateway.
    "CLOUDFLARE_ACCOUNT_ID": "c1175ba92905ae7eb4bf4f0f987ca8d2",
    "CLOUDFLARE_GATEWAY_ID": "dak"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
