{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dak-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dak",
      "database_id": "3613c8de-a4cb-472c-b00f-b4a4cc2bb5a0"
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }
  ],
  "containers": [
    {
      "class_name": "RsshubContainer",
      "image": "./rsshub.Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      { "class_name": "RsshubContainer", "name": "RSSHUB" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["RsshubContainer"], "tag": "v1" }
  ],
  "vars": {
    "RSSHUB_BASE_URL": "http://rsshub.internal"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
